# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=replace-with-a-secure-random-secret-key
PORT=5000

# Firebase Configuration
# Option 1: Path to local serviceAccountKey.json file
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# Option 2: Raw JSON string for cloud/container deployment (leave empty if using Option 1)
# FIREBASE_CREDENTIALS_JSON=

# Firebase Project ID (Optional if contained in serviceAccountKey.json)
FIREBASE_PROJECT_ID=your-firebase-project-id

# LLM API Configuration (Groq or Grok)
# Option A: Groq API (Fast LLaMA 3.3 70B inference)
GROQ_API_KEY=gsk_your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Option B: xAI Grok API (Uncomment if using xAI Grok)
# GROK_API_KEY=xai-your-grok-api-key-here
# LLM_PROVIDER=grok
# LLM_MODEL=grok-beta
